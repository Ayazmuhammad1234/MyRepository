public Map<String, Object> buildChartResponse(List<Map<String, Object>> rows) {

    List<String> categories = new ArrayList<>();
    Map<String, List<Number>> seriesMap = new LinkedHashMap<>();

    for (Map<String, Object> row : rows) {

        String categoryValue = null;

        // 1️⃣ Find category (String column)
        for (Map.Entry<String, Object> entry : row.entrySet()) {
            if (entry.getValue() instanceof String) {
                categoryValue = entry.getValue().toString();
                break;
            }
        }

        categories.add(categoryValue);

        // 2️⃣ Process numeric columns dynamically
        for (Map.Entry<String, Object> entry : row.entrySet()) {

            if (entry.getValue() instanceof Number) {

                String columnName = entry.getKey();
                Number value = (Number) entry.getValue();

                seriesMap
                        .computeIfAbsent(columnName, k -> new ArrayList<>())
                        .add(value);
            }
        }
    }

    // 3️⃣ Convert to final response
    List<Map<String, Object>> series = new ArrayList<>();

    for (Map.Entry<String, List<Number>> entry : seriesMap.entrySet()) {
        Map<String, Object> seriesObj = new HashMap<>();
        seriesObj.put("name", formatSeriesName(entry.getKey()));
        seriesObj.put("data", entry.getValue());
        series.add(seriesObj);
    }

    Map<String, Object> response = new HashMap<>();
    response.put("category", categories);
    response.put("series", series);

    return response;
}
















public ChartResponseDto buildTopcard2Chart(List<Map<String, Object>> dbResult) {

    List<String> categories = new ArrayList<>();

    List<Integer> blue = new ArrayList<>();
    List<Integer> amber = new ArrayList<>();
    List<Integer> green = new ArrayList<>();
    List<Integer> red = new ArrayList<>();
    List<Integer> notStarted = new ArrayList<>();

    for (Map<String, Object> row : dbResult) {

        categories.add((String) row.get("DUE_YEAR_CATEGORY"));

        blue.add(getInt(row.get("BLUE_MSCOUNT")));
        amber.add(getInt(row.get("AMBER_MSCOUNT")));
        green.add(getInt(row.get("GREEN_MSCOUNT")));
        red.add(getInt(row.get("RED_MSCOUNT")));
        notStarted.add(getInt(row.get("NOTSTARTED_MSCOUNT")));
    }

    List<ChartSeriesDto> series = List.of(
        new ChartSeriesDto("Blue", blue),
        new ChartSeriesDto("Amber", amber),
        new ChartSeriesDto("Green", green),
        new ChartSeriesDto("Red", red),
        new ChartSeriesDto("Not Started", notStarted)
    );

    return new ChartResponseDto(categories, series);
}

private Integer getInt(Object value) {
    return value == null ? 0 : ((Number) value).intValue();
}
