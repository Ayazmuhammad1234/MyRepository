public final class GlobalFilterSqlBuilder {

    private GlobalFilterSqlBuilder() {}

    public static String applyGlobalFilters(
            String sql,
            MapSqlParameterSource params,
            GlobalFilterRequestDto req
    ) {

        /* ================= USE CASE ================= */

        sql = addInFilter(sql, params, "USE_CASE_NO", req.getUseCaseNo());
        sql = addInFilter(sql, params, "USE_CASE_OWNERSHIP", req.getUseCaseOwnership());
        sql = addInFilter(sql, params, "USE_CASE_OWNER", req.getUseCaseOwner());
        sql = addInFilter(sql, params, "USE_CASE_ACCOUNTABLE_EXECUTIVE", req.getUseCaseAccountableExecutive());
        sql = addInFilter(sql, params, "USE_CASE_CATEGORY", req.getUseCaseCategory());
        sql = addInFilter(sql, params, "PROJECT_OVERALL_RAG_STATUS", req.getProjectOverallRagStatus());

        /* ================= USE CASE DUE DATE (DERIVED) ================= */

        sql = addInFilter(sql, params, "USE_CASE_DUE_DT_YEAR", req.getUseCaseDueDtYear());
        sql = addInFilter(sql, params, "USE_CASE_DUE_DT_QTR", req.getUseCaseDueDtQtr());
        sql = addInFilter(sql, params, "USE_CASE_DUE_DT_MONTH", req.getUseCaseDueDtMonth());

        /* ================= OWNERS ================= */

        sql = addInFilter(sql, params, "SMT_ACCOUNTABLE_EXECUTIVE", req.getSmtAccountableExecutive());
        sql = addInFilter(sql, params, "MILESTONE_OWNER", req.getMilestoneOwner());
        sql = addInFilter(sql, params, "DELIVERABLE_OWNER", req.getDeliverableOwner());

        /* ================= MILESTONE DATE (DERIVED) ================= */

        sql = addInFilter(sql, params, "MILESTONE_YEAR", req.getMilestoneYear());
        sql = addInFilter(sql, params, "MILESTONE_QTR", req.getMilestoneQtr());
        sql = addInFilter(sql, params, "MILESTONE_MONTH", req.getMilestoneMonth());

        /* ================= DELIVERABLE DATE (DERIVED) ================= */

        sql = addInFilter(sql, params, "DELIVERABLE_YEAR", req.getDeliverableYear());
        sql = addInFilter(sql, params, "DELIVERABLE_QTR", req.getDeliverableQtr());
        sql = addInFilter(sql, params, "DELIVERABLE_MONTH", req.getDeliverableMonth());

        /* ================= WORK EFFORT ================= */

        sql = addInFilter(sql, params, "INITIATIVE_NAME", req.getInitiativeName());
        sql = addInFilter(sql, params, "PROGRAM_NAME", req.getProgramName());
        sql = addInFilter(sql, params, "WORK_EFFORT_NAME", req.getWorkEffortName());
        sql = addInFilter(sql, params, "DERIVED_PROGRAM_CATEGORY", req.getDerivedProgramCategory());

        /* ================= OTHER ATTRIBUTES ================= */

        sql = addInFilter(sql, params, "OCC_CONSENT_ORDER_ARTICLE", req.getOccConsentOrderArticle());
        sql = addInFilter(sql, params, "SUBPORTFOLIO_NAME", req.getSubportfolioName());

        /* ================= RAG STATUS ================= */

        sql = addInFilter(sql, params, "MILESTONE_RAG_STATUS", req.getMilestoneRagStatus());
        sql = addInFilter(sql, params, "DELIVERABLE_RAG_STATUS", req.getDeliverableRagStatus());

        return sql;
    }
}








private static String addInFilter(
        String sql,
        MapSqlParameterSource params,
        String column,
        List<?> values
) {
    if (values != null && !values.isEmpty()) {
        sql += " AND " + column + " IN (:" + column + ")";
        params.addValue(column, values);
    }
    return sql;
}
