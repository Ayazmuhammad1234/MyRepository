public final class GlobalFilterSqlBuilder {

    private GlobalFilterSqlBuilder() {}

    public static String applyGlobalFilters(
            String sql,
            MapSqlParameterSource params,
            GlobalFilterRequestDto req
    ) {

        StringBuilder sb = new StringBuilder(sql);

        /* ================= USE CASE ================= */

        addInFilter(sb, params, "USE_CASE_NO", req.getUseCaseNo());
        addInFilter(sb, params, "USE_CASE_OWNERSHIP", req.getUseCaseOwnership());
        addInFilter(sb, params, "USE_CASE_OWNER", req.getUseCaseOwner());
        addInFilter(sb, params, "USE_CASE_ACCOUNTABLE_EXECUTIVE", req.getUseCaseAccountableExecutive());
        addInFilter(sb, params, "USE_CASE_CATEGORY", req.getUseCaseCategory());
        addInFilter(sb, params, "PROJECT_OVERALL_RAG_STATUS", req.getProjectOverallRagStatus());

        /* ================= USE CASE DUE DATE (DERIVED) ================= */

        addInFilter(sb, params, "USE_CASE_DUE_DT_YEAR", req.getUseCaseDueDtYear());
        addInFilter(sb, params, "USE_CASE_DUE_DT_QTR", req.getUseCaseDueDtQtr());
        addInFilter(sb, params, "USE_CASE_DUE_DT_MONTH", req.getUseCaseDueDtMonth());

        /* ================= OWNERS ================= */

        addInFilter(sb, params, "SMT_ACCOUNTABLE_EXECUTIVE", req.getSmtAccountableExecutive());
        addInFilter(sb, params, "MILESTONE_OWNER", req.getMilestoneOwner());
        addInFilter(sb, params, "DELIVERABLE_OWNER", req.getDeliverableOwner());

        /* ================= MILESTONE DATE (DERIVED) ================= */

        addInFilter(sb, params, "MILESTONE_YEAR", req.getMilestoneYear());
        addInFilter(sb, params, "MILESTONE_QTR", req.getMilestoneQtr());
        addInFilter(sb, params, "MILESTONE_MONTH", req.getMilestoneMonth());

        /* ================= DELIVERABLE DATE (DERIVED) ================= */

        addInFilter(sb, params, "DELIVERABLE_YEAR", req.getDeliverableYear());
        addInFilter(sb, params, "DELIVERABLE_QTR", req.getDeliverableQtr());
        addInFilter(sb, params, "DELIVERABLE_MONTH", req.getDeliverableMonth());

        /* ================= WORK EFFORT ================= */

        addInFilter(sb, params, "INITIATIVE_NAME", req.getInitiativeName());
        addInFilter(sb, params, "PROGRAM_NAME", req.getProgramName());
        addInFilter(sb, params, "WORK_EFFORT_NAME", req.getWorkEffortName());
        addInFilter(sb, params, "DERIVED_PROGRAM_CATEGORY", req.getDerivedProgramCategory());

        /* ================= OTHER ATTRIBUTES ================= */

        addInFilter(sb, params, "OCC_CONSENT_ORDER_ARTICLE", req.getOccConsentOrderArticle());
        addInFilter(sb, params, "SUBPORTFOLIO_NAME", req.getSubportfolioName());

        /* ================= RAG STATUS ================= */

        addInFilter(sb, params, "MILESTONE_RAG_STATUS", req.getMilestoneRagStatus());
        addInFilter(sb, params, "DELIVERABLE_RAG_STATUS", req.getDeliverableRagStatus());

        return sb.toString();
    }

    /* ================= GENERIC IN FILTER ================= */

    private static void addInFilter(
            StringBuilder sb,
            MapSqlParameterSource params,
            String column,
            List<?> values
    ) {
        if (values != null && !values.isEmpty()) {
            sb.append(" AND ")
              .append(column)
              .append(" IN (:")
              .append(column)
              .append(")");
            params.addValue(column, values);
        }
    }
}
