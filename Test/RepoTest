import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.*;
import static org.mockito.Mockito.*;

import java.sql.ResultSet;
import java.util.List;
import java.util.Map;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.jdbc.core.ResultSetExtractor;
import org.springframework.jdbc.core.namedparam.MapSqlParameterSource;
import org.springframework.jdbc.core.namedparam.NamedParameterJdbcTemplate;

@ExtendWith(MockitoExtension.class)
class DeliverableRepositoryTest {

    @Mock
    private NamedParameterJdbcTemplate jdbcTemplate;

    @InjectMocks
    private DeliverableRepository repository; // 👉 Change if your repo name differs


    // ✅ Test 1 : Success Scenario
    @Test
    void getDeliverablePopUpGridData_ReturnsData_WhenQuerySucceeds() throws Exception {

        GlobalFilterRequestDto request = new GlobalFilterRequestDto();

        List<Map<String, Object>> mockResponse =
                List.of(Map.of("Column1", "Value1"));

        // ⭐ Important → Cast to ResultSetExtractor to avoid ambiguity
        when(jdbcTemplate.query(
                anyString(),
                any(MapSqlParameterSource.class),
                any(ResultSetExtractor.class)
        )).thenReturn(mockResponse);

        List<Map<String, Object>> result =
                repository.getDeliverablePopUpGridData(request, 0, 10);

        assertNotNull(result);
        assertEquals(1, result.size());
        assertEquals("Value1", result.get(0).get("Column1"));

        verify(jdbcTemplate, times(1))
                .query(anyString(), any(MapSqlParameterSource.class), any(ResultSetExtractor.class));
    }


    // ✅ Test 2 : Exception Scenario
    @Test
    void getDeliverablePopUpGridData_ReturnsEmptyList_WhenExceptionOccurs() {

        when(jdbcTemplate.query(
                anyString(),
                any(MapSqlParameterSource.class),
                any(ResultSetExtractor.class)
        )).thenThrow(new RuntimeException("Database error"));

        List<Map<String, Object>> result =
                repository.getDeliverablePopUpGridData(new GlobalFilterRequestDto(), 0, 10);

        assertNotNull(result);
        assertTrue(result.isEmpty());
    }


    // ✅ Test 3 : Pagination Parameter Verification
    @Test
    void getDeliverablePopUpGridData_VerifyPaginationParams() {

        GlobalFilterRequestDto request = new GlobalFilterRequestDto();

        when(jdbcTemplate.query(
                anyString(),
                any(MapSqlParameterSource.class),
                any(ResultSetExtractor.class)
        )).thenReturn(List.of());

        repository.getDeliverablePopUpGridData(request, 20, 25);

        verify(jdbcTemplate).query(
                contains("OFFSET"),
                argThat((MapSqlParameterSource params) ->
                        params.getValue("offset").equals(20)
                                && params.getValue("size").equals(25)
                ),
                any(ResultSetExtractor.class)
        );
    }
}









